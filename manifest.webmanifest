{
  "name": "Smart Pocket – paragony za parkowanie",
  "short_name": "Smart Pocket",
  "description": "Digitalizacja, OCR i rozliczanie paragonów za parkowanie samochodu służbowego.",
  "lang": "pl",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4f6f5",
  "theme_color": "#0f5c4d",
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    { "name": "Zrób zdjęcie paragonu", "url": "./#/", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Do weryfikacji", "url": "./#/receipts", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "images", "accept": ["image/*"] }] }
  }
}
